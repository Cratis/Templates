<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageType>Template</PackageType>
        <PackageId>Cratis.Templates.Java</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>Cratis Java Templates</Title>
        <Description>A template for creating Java web applications with Cratis Arc and Chronicle on Spring Boot</Description>
        <Author>Cratis</Author>
        <PackageTags>dotnet;templates;cratis;arc;chronicle;web;java;springboot</PackageTags>
        <RepositoryUrl>https://github.com/Cratis/Templates</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <License>MIT</License>
        <IncludeContentInPack>true</IncludeContentInPack>
        <NoWarn>$(NoWarn);CS8805;CS0103;IDE0073;SA1512;SA1515;SA1005</NoWarn>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Templates\**\*" />
        <None Remove="Templates\**\*" />
    </ItemGroup>

    <!--
        Testing/ is gitignored scratch space for locally scaffolded applications.
        It is absent from a fresh checkout, but the SDK's default **/*.cs glob
        otherwise compiles whatever a developer has scaffolded there. Nothing
        under Testing/ is packed.
    -->
    <ItemGroup>
        <Compile Remove="Testing\**\*" />
        <None Remove="Testing\**\*" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Templates/Cratis.Java/**/*" />

        <!--
            The Include above is a filesystem glob, so it also picks up anything
            a local build has left inside the template folder - Gradle build
            output, scaffolded frontend node_modules. CI packs from a fresh
            checkout and never sees these, but `TestLocal.sh` and any maintainer
            packing locally would otherwise ship compiled output inside the
            template content, and scaffold it back out into consumers' projects.
            These are the paths .gitignore already excludes from the repository.
        -->
        <Content Remove="Templates/Cratis.Java/**/bin/**" />
        <Content Remove="Templates/Cratis.Java/**/obj/**" />
        <Content Remove="Templates/Cratis.Java/**/build/**" />
        <Content Remove="Templates/Cratis.Java/**/.gradle/**" />
        <Content Remove="Templates/Cratis.Java/**/node_modules/**" />
        <Content Remove="Templates/Cratis.Java/**/src/main/resources/static/**" />
        <Content Remove="Templates/Cratis.Java/**/Properties/launchSettings.json" />
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
