{
    "$schema": "http://json.schemastore.org/template",
    "author": "Cratis",
    "classifications": [
        "Web",
        "ASP.NET",
        "Cratis",
        "Arc",
        "Chronicle",
        "Aspire"
    ],
    "identity": "Cratis.Templates.Aspire",
    "name": "Cratis Aspire Application",
    "shortName": "cratis-aspire",
    "description": "A template for creating a Cratis web application with .NET Aspire orchestration",
    "tags": {
        "language": "C#",
        "type": "solution"
    },
    "sourceName": "CratisAspire",
    "preferNameDirectory": true,
    "primaryOutputs": [
        {
            "path": "CratisAspire.sln"
        }
    ],
    "symbols": {
        "Framework": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "net10.0",
                    "description": ".NET 10"
                }
            ],
            "defaultValue": "net10.0",
            "description": "Target framework",
            "replaces": "TARGET_FRAMEWORK"
        },
        "ProjectGuid": {
            "type": "generated",
            "generator": "guid",
            "replaces": "PROJECT_GUID"
        },
        "CompositionGuid": {
            "type": "generated",
            "generator": "guid",
            "replaces": "COMPOSITION_GUID"
        },
        "InfrastructureGuid": {
            "type": "generated",
            "generator": "guid",
            "replaces": "INFRASTRUCTURE_GUID"
        },
        "Database": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "MongoDB"
                },
                {
                    "choice": "PostgreSQL"
                },
                {
                    "choice": "MsSql"
                },
                {
                    "choice": "SQLite"
                }
            ],
            "defaultValue": "MongoDB",
            "replaces": "DATABASE",
            "enableQuotelessLiterals": true
        },
        "databaseAppConnectionString": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_APP_CONNECTION",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\")",
                        "value": ""
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\")",
                        "value": "Host=localhost;Port=5432;Database=CratisApp;Username=cratis;Password=cratis-dev-2026"
                    },
                    {
                        "condition": "(Database == \"MsSql\")",
                        "value": "Server=localhost,1433;Database=CratisApp;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true"
                    },
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "Data Source=CratisApp.db"
                    }
                ]
            }
        },
        "cratisMongoDb": {
            "type": "computed",
            "value": "(Database == \"MongoDB\")"
        },
        "cratisPostgreSql": {
            "type": "computed",
            "value": "(Database == \"PostgreSQL\")"
        },
        "cratisMsSql": {
            "type": "computed",
            "value": "(Database == \"MsSql\")"
        },
        "cratisSqlite": {
            "type": "computed",
            "value": "(Database == \"SQLite\")"
        },
        "cratisEntityFrameworkCore": {
            "type": "computed",
            "value": "(Database != \"MongoDB\")"
        },
        "SkipAiUpdateInstructions": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Suppress the cratis ai update hint in the getting-started instructions (the Cratis CLI runs the update automatically)."
        }
    },
    "sources": [
        {
            "exclude": [
                "**/.template.config/**"
            ]
        }
    ],
    "postActions": [
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Cratis NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Cratis NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Cratis",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Cratis.Arc.MongoDB NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Cratis.Arc.MongoDB NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Cratis.Arc.MongoDB",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Cratis.Chronicle.Aspire NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Cratis.Chronicle.Aspire NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Cratis.Chronicle.Aspire",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Composition.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Microsoft.Extensions.Http.Resilience NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Microsoft.Extensions.Http.Resilience NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Microsoft.Extensions.Http.Resilience",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Microsoft.Extensions.ServiceDiscovery NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Microsoft.Extensions.ServiceDiscovery NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Microsoft.Extensions.ServiceDiscovery",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add OpenTelemetry.Exporter.OpenTelemetryProtocol NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the OpenTelemetry.Exporter.OpenTelemetryProtocol NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "OpenTelemetry.Exporter.OpenTelemetryProtocol",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add OpenTelemetry.Extensions.Hosting NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the OpenTelemetry.Extensions.Hosting NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "OpenTelemetry.Extensions.Hosting",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add OpenTelemetry.Instrumentation.AspNetCore NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the OpenTelemetry.Instrumentation.AspNetCore NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "OpenTelemetry.Instrumentation.AspNetCore",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add OpenTelemetry.Instrumentation.Http NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the OpenTelemetry.Instrumentation.Http NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "OpenTelemetry.Instrumentation.Http",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add OpenTelemetry.Instrumentation.Runtime NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the OpenTelemetry.Instrumentation.Runtime NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "OpenTelemetry.Instrumentation.Runtime",
                "projectFileExtensions": ".csproj",
                "targetFiles": "[\"**/CratisAspire.Infrastructure.csproj\"]"
            },
            "continueOnError": true
        },
        {
            "description": "Restore NuGet packages required by this project.",
            "manualInstructions": [
                {
                    "text": "Run 'dotnet restore'"
                }
            ],
            "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
            "continueOnError": true
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps (exact commands, with your project name, are in README.md):\n  1. Install frontend dependencies:  cd into the web app folder, then run 'yarn install'\n  2. Run the application:            'dotnet run' on the .Composition project\n  3. Frontend dev server:            run 'yarn dev' in the web app folder"
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\n  Make sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n      cratis ai update\n  to get all the AI rules, skills, and coding agent integration in place."
                }
            ],
            "args": {
                "files": "1"
            },
            "condition": "(SkipAiUpdateInstructions != true)"
        }
    ]
}
