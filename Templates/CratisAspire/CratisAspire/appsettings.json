{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
//#if (cratisEntityFrameworkCore)
    "ConnectionStrings": {
        "Cratis": ""
    },
//#endif
    "Cratis": {
        "Arc": {
            "GeneratedApis": {
                "RoutePrefix": "api",
                "IncludeCommandNameInRoute": false,
                "SegmentsToSkipForRoute": 1
            }
        },
        "Chronicle": {
//#if (cratisEntityFrameworkCore)
            "DefaultSinkTypeId": "SQL",
//#endif
            "EventStore": "CratisAspire"
        },
        "MongoDB": {
            "Database": "CratisAspire"
        }
    }
}
