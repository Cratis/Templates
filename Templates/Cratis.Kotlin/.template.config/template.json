{
    "$schema": "http://json.schemastore.org/template",
    "author": "Cratis",
    "classifications": [
        "Web",
        "Spring Boot",
        "Cratis",
        "Arc",
        "Chronicle",
        "Kotlin"
    ],
    "identity": "Cratis.Templates.Kotlin",
    "groupIdentity": "Cratis.Templates.Cratis",
    "name": "Cratis Kotlin Application",
    "shortName": "cratis",
    "description": "A template for creating a Cratis web application with Kotlin and Spring Boot",
    "tags": {
        "language": "Kotlin",
        "type": "project"
    },
    "sourceName": "CratisApp",
    "preferNameDirectory": true,
    "symbols": {
        "Database": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "MongoDB"
                },
                {
                    "choice": "PostgreSQL"
                },
                {
                    "choice": "MsSql"
                },
                {
                    "choice": "SQLite"
                }
            ],
            "defaultValue": "MongoDB",
            "replaces": "DATABASE",
            "enableQuotelessLiterals": true
        },
        "databaseSinkType": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_SINK_TYPE",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\")",
                        "value": "MONGODB"
                    },
                    {
                        "condition": "(Database != \"MongoDB\")",
                        "value": "SQL"
                    }
                ]
            }
        },
        "databaseKernelConnectionDetails": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_KERNEL_CONNECTION",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\")",
                        "value": "mongodb://localhost:27017"
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\")",
                        "value": "Host=database;Port=5432;Database=chronicle;Username=chronicle;Password=cratis-dev-2026"
                    },
                    {
                        "condition": "(Database == \"MsSql\")",
                        "value": "Server=database,1433;Database=chronicle;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true"
                    },
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "Data Source=/data/chronicle.db"
                    }
                ]
            }
        },
        "databaseDependsOn": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_DEPENDS_ON",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"PostgreSQL\" || Database == \"MsSql\")",
                        "value": "depends_on:\n      database:\n        condition: service_healthy"
                    },
                    {
                        "condition": "(Database == \"MongoDB\" || Database == \"SQLite\")",
                        "value": ""
                    }
                ]
            }
        },
        "databaseVolumes": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_VOLUMES",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "volumes:\n      - chronicle-data:/data"
                    },
                    {
                        "condition": "(Database != \"SQLite\")",
                        "value": ""
                    }
                ]
            }
        },
        "databaseService": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_SERVICE",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\" || Database == \"SQLite\")",
                        "value": ""
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\")",
                        "value": "  database:\n    image: postgres:17\n    environment:\n      - POSTGRES_USER=chronicle\n      - POSTGRES_PASSWORD=cratis-dev-2026\n      - POSTGRES_DB=chronicle\n    ports:\n      - 5432:5432\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U chronicle\"]\n      interval: 5s\n      timeout: 5s\n      retries: 12"
                    },
                    {
                        "condition": "(Database == \"MsSql\")",
                        "value": "  database:\n    image: mcr.microsoft.com/mssql/server:2022-latest\n    environment:\n      - ACCEPT_EULA=Y\n      - MSSQL_SA_PASSWORD=YourStrong!Passw0rd\n    ports:\n      - 1433:1433\n    healthcheck:\n      test: [\"CMD-SHELL\", \"/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P 'YourStrong!Passw0rd' -Q 'SELECT 1' || exit 1\"]\n      interval: 10s\n      timeout: 5s\n      retries: 12"
                    }
                ]
            }
        },
        "databaseTopVolumes": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_TOP_VOLUMES",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "volumes:\n  chronicle-data:"
                    },
                    {
                        "condition": "(Database != \"SQLite\")",
                        "value": ""
                    }
                ]
            }
        },
        "packageManager": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "yarn",
                    "description": "Use yarn"
                },
                {
                    "choice": "pnpm",
                    "description": "Use pnpm"
                },
                {
                    "choice": "npm",
                    "description": "Use npm"
                },
                {
                    "choice": "none",
                    "description": "Skip package installation"
                }
            ],
            "defaultValue": "yarn",
            "description": "Package manager to use for frontend dependencies",
            "prompt": "Select frontend package manager"
        },
        "packageManagerInstallCommand": {
            "type": "generated",
            "generator": "switch",
            "replaces": "PACKAGE_MGR_INSTALL",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(packageManager == \"yarn\")",
                        "value": "yarn install"
                    },
                    {
                        "condition": "(packageManager == \"pnpm\")",
                        "value": "pnpm install"
                    },
                    {
                        "condition": "(packageManager == \"npm\")",
                        "value": "npm install"
                    },
                    {
                        "condition": "(packageManager == \"none\")",
                        "value": "# Run your preferred package manager install command (e.g. npm install)"
                    }
                ]
            }
        },
        "packageManagerDevCommand": {
            "type": "generated",
            "generator": "switch",
            "replaces": "PACKAGE_MGR_DEV",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(packageManager == \"yarn\")",
                        "value": "yarn dev"
                    },
                    {
                        "condition": "(packageManager == \"pnpm\")",
                        "value": "pnpm dev"
                    },
                    {
                        "condition": "(packageManager == \"npm\")",
                        "value": "npm run dev"
                    },
                    {
                        "condition": "(packageManager == \"none\")",
                        "value": "# Run your preferred package manager dev command (e.g. npm run dev)"
                    }
                ]
            }
        },
        "SkipAiUpdateInstructions": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Suppress the cratis ai update hint in the getting-started instructions (the Cratis CLI runs the update automatically)."
        }
    },
    "sources": [
        {
            "exclude": [
                "**/.template.config/**"
            ]
        }
    ],
    "postActions": [
        {
            "description": "Make gradlew executable.",
            "manualInstructions": [
                {
                    "text": "Run 'chmod +x gradlew'"
                }
            ],
            "actionId": "cb9a6cf3-4f5c-4860-b9d2-03a574959774",
            "args": {
                "+x": "gradlew"
            },
            "continueOnError": true
        },
        {
            "description": "Make run.sh executable.",
            "manualInstructions": [
                {
                    "text": "Run 'chmod +x run.sh'"
                }
            ],
            "actionId": "cb9a6cf3-4f5c-4860-b9d2-03a574959774",
            "args": {
                "+x": "run.sh"
            },
            "continueOnError": true
        },
        {
            "description": "Install all frontend dependencies with yarn.",
            "manualInstructions": [
                {
                    "text": "Run 'yarn install'"
                }
            ],
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "condition": "(packageManager == \"yarn\")",
            "args": {
                "executable": "yarn",
                "args": "install"
            },
            "continueOnError": true
        },
        {
            "description": "Install all frontend dependencies with pnpm.",
            "manualInstructions": [
                {
                    "text": "Run 'pnpm install'"
                }
            ],
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "condition": "(packageManager == \"pnpm\")",
            "args": {
                "executable": "pnpm",
                "args": "install"
            },
            "continueOnError": true
        },
        {
            "description": "Install all frontend dependencies with npm.",
            "manualInstructions": [
                {
                    "text": "Run 'npm install'"
                }
            ],
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "condition": "(packageManager == \"npm\")",
            "args": {
                "executable": "npm",
                "args": "install"
            },
            "continueOnError": true
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"yarn\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n\n  Requirements: JDK 17 and Docker.\n  1. Start infrastructure:  docker compose up -d\n     (or just run everything: ./run.sh)\n  2. Build (generates the frontend proxies):  ./gradlew build\n  3. Run the application:    ./gradlew bootRun\n  4. Frontend dev server:    yarn dev\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"yarn\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\nMake sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n    cratis ai update\nto get all the AI rules, skills, and coding agent integration in place."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"pnpm\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n\n  Requirements: JDK 17 and Docker.\n  1. Start infrastructure:  docker compose up -d\n     (or just run everything: ./run.sh)\n  2. Build (generates the frontend proxies):  ./gradlew build\n  3. Run the application:    ./gradlew bootRun\n  4. Frontend dev server:    pnpm dev\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"pnpm\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\nMake sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n    cratis ai update\nto get all the AI rules, skills, and coding agent integration in place."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"npm\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n\n  Requirements: JDK 17 and Docker.\n  1. Start infrastructure:  docker compose up -d\n     (or just run everything: ./run.sh)\n  2. Build (generates the frontend proxies):  ./gradlew build\n  3. Run the application:    ./gradlew bootRun\n  4. Frontend dev server:    npm run dev\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
