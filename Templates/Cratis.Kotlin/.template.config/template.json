            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"npm\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\nMake sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n    cratis ai update\nto get all the AI rules, skills, and coding agent integration in place."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"none\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n\n  Requirements: JDK 17 and Docker.\n  1. Start infrastructure:  docker compose up -d\n     (or just run everything: ./run.sh)\n  2. Build (generates the frontend proxies):  ./gradlew build\n  3. Run the application:    ./gradlew bootRun\n  4. Frontend dev server:    # Run your preferred package manager dev command (e.g. npm run dev)\n\nSee README.md for full details."
