{
    "$schema": "http://json.schemastore.org/template",
    "author": "Cratis",
    "classifications": [
        "Web",
        "ASP.NET",
        "Cratis",
        "Arc",
        "Chronicle"
    ],
    "identity": "Cratis.Templates.Web",
    "groupIdentity": "Cratis.Templates.Cratis",
    "name": "Cratis Web Application",
    "shortName": "cratis",
    "description": "A template for creating a Cratis web application",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "CratisApp",
    "preferNameDirectory": true,
    "primaryOutputs": [
        {
            "path": "CratisApp.csproj"
        }
    ],
    "symbols": {
        "Framework": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "net10.0",
                    "description": ".NET 10"
                }
            ],
            "defaultValue": "net10.0",
            "description": "Target framework",
            "replaces": "TARGET_FRAMEWORK"
        },
        "Database": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "MongoDB"
                },
                {
                    "choice": "PostgreSQL"
                },
                {
                    "choice": "MsSql"
                },
                {
                    "choice": "SQLite"
                }
            ],
            "defaultValue": "MongoDB",
            "replaces": "DATABASE",
            "enableQuotelessLiterals": true
        },
        "databaseAppConnectionString": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_APP_CONNECTION",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\")",
                        "value": ""
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\")",
                        "value": "Host=localhost;Port=5432;Database=CratisApp;Username=cratis;Password=cratis-dev-2026"
                    },
                    {
                        "condition": "(Database == \"MsSql\")",
                        "value": "Server=localhost,1433;Database=CratisApp;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true"
                    },
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "Data Source=CratisApp.db"
                    }
                ]
            }
        },
        "databaseKernelConnectionDetails": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_KERNEL_CONNECTION",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\")",
                        "value": "mongodb://localhost:27017"
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\")",
                        "value": "Host=database;Port=5432;Database=chronicle;Username=chronicle;Password=cratis-dev-2026"
                    },
                    {
                        "condition": "(Database == \"MsSql\")",
                        "value": "Server=database,1433;Database=chronicle;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true"
                    },
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "Data Source=/data/chronicle.db"
                    }
                ]
            }
        },
        "databaseDependsOn": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_DEPENDS_ON",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\" || Database == \"SQLite\")",
                        "value": ""
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\" || Database == \"MsSql\")",
                        "value": "depends_on:\n      database:\n        condition: service_healthy"
                    }
                ]
            }
        },
        "databaseVolumes": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_VOLUMES",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "volumes:\n      - chronicle-data:/data"
                    },
                    {
                        "condition": "(Database != \"SQLite\")",
                        "value": ""
                    }
                ]
            }
        },
        "databaseService": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_SERVICE",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"MongoDB\" || Database == \"SQLite\")",
                        "value": ""
                    },
                    {
                        "condition": "(Database == \"PostgreSQL\")",
                        "value": "  database:\n    image: postgres:17\n    environment:\n      - POSTGRES_USER=chronicle\n      - POSTGRES_PASSWORD=cratis-dev-2026\n      - POSTGRES_DB=chronicle\n    ports:\n      - 5432:5432\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U chronicle\"]\n      interval: 5s\n      timeout: 5s\n      retries: 12"
                    },
                    {
                        "condition": "(Database == \"MsSql\")",
                        "value": "  database:\n    image: mcr.microsoft.com/mssql/server:2022-latest\n    environment:\n      - ACCEPT_EULA=Y\n      - MSSQL_SA_PASSWORD=YourStrong!Passw0rd\n    ports:\n      - 1433:1433\n    healthcheck:\n      test: [\"CMD-SHELL\", \"/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P 'YourStrong!Passw0rd' -Q 'SELECT 1' || exit 1\"]\n      interval: 10s\n      timeout: 5s\n      retries: 12"
                    }
                ]
            }
        },
        "databaseTopVolumes": {
            "type": "generated",
            "generator": "switch",
            "replaces": "DATABASE_TOP_VOLUMES",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(Database == \"SQLite\")",
                        "value": "volumes:\n  chronicle-data:"
                    },
                    {
                        "condition": "(Database != \"SQLite\")",
                        "value": ""
                    }
                ]
            }
        },
        "packageManager": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "yarn",
                    "description": "Use yarn"
                },
                {
                    "choice": "pnpm",
                    "description": "Use pnpm"
                },
                {
                    "choice": "npm",
                    "description": "Use npm"
                },
                {
                    "choice": "none",
                    "description": "Skip package installation"
                }
            ],
            "defaultValue": "yarn",
            "description": "Package manager to use for frontend dependencies",
            "prompt": "Select frontend package manager"
        },
        "packageManagerInstallCommand": {
            "type": "generated",
            "generator": "switch",
            "replaces": "PACKAGE_MGR_INSTALL",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(packageManager == \"yarn\")",
                        "value": "yarn install"
                    },
                    {
                        "condition": "(packageManager == \"pnpm\")",
                        "value": "pnpm install"
                    },
                    {
                        "condition": "(packageManager == \"npm\")",
                        "value": "npm install"
                    },
                    {
                        "condition": "(packageManager == \"none\")",
                        "value": "# Run your preferred package manager install command (e.g. npm install)"
                    }
                ]
            }
        },
        "packageManagerDevCommand": {
            "type": "generated",
            "generator": "switch",
            "replaces": "PACKAGE_MGR_DEV",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(packageManager == \"yarn\")",
                        "value": "yarn dev"
                    },
                    {
                        "condition": "(packageManager == \"pnpm\")",
                        "value": "pnpm dev"
                    },
                    {
                        "condition": "(packageManager == \"npm\")",
                        "value": "npm run dev"
                    },
                    {
                        "condition": "(packageManager == \"none\")",
                        "value": "# Run your preferred package manager dev command (e.g. npm run dev)"
                    }
                ]
            }
        },
        "ProjectGuid": {
            "type": "generated",
            "generator": "guid",
            "replaces": "PROJECT_GUID"
        },
        "cratisMongoDb": {
            "type": "computed",
            "value": "(Database == \"MongoDB\")"
        },
        "cratisEntityFrameworkCore": {
            "type": "computed",
            "value": "(Database != \"MongoDB\")"
        },
        "SkipAiUpdateInstructions": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Suppress the cratis ai update hint in the getting-started instructions (the Cratis CLI runs the update automatically)."
        }
    },
    "sources": [
        {
            "exclude": [
                "**/.template.config/**"
            ]
        }
    ],
    "postActions": [
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Cratis NuGet package.",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Cratis NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Cratis",
                "projectFileExtensions": ".csproj"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Cratis Arc MongoDB NuGet package.",
            "condition": "(Database == \"MongoDB\")",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Cratis.Arc.MongoDB NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Cratis.Arc.MongoDB",
                "projectFileExtensions": ".csproj"
            },
            "continueOnError": true
        },
        {
            "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
            "description": "Add Cratis Arc Entity Framework Core NuGet package.",
            "condition": "(Database != \"MongoDB\")",
            "manualInstructions": [
                {
                    "text": "Add a reference to the Cratis.Arc.EntityFrameworkCore NuGet package"
                }
            ],
            "args": {
                "referenceType": "package",
                "reference": "Cratis.Arc.EntityFrameworkCore",
                "projectFileExtensions": ".csproj"
            },
            "continueOnError": true
        },
        {
            "description": "Restore NuGet packages required by this project.",
            "manualInstructions": [
                {
                    "text": "Run 'dotnet restore'"
                }
            ],
            "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
            "continueOnError": true
        },
        {
            "description": "Install all frontend dependencies with yarn.",
            "manualInstructions": [
                {
                    "text": "Run 'yarn install'"
                }
            ],
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "condition": "(packageManager == \"yarn\")",
            "args": {
                "executable": "yarn",
                "args": "install"
            },
            "continueOnError": true
        },
        {
            "description": "Install all frontend dependencies with pnpm.",
            "manualInstructions": [
                {
                    "text": "Run 'pnpm install'"
                }
            ],
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "condition": "(packageManager == \"pnpm\")",
            "args": {
                "executable": "pnpm",
                "args": "install"
            },
            "continueOnError": true
        },
        {
            "description": "Install all frontend dependencies with npm.",
            "manualInstructions": [
                {
                    "text": "Run 'npm install'"
                }
            ],
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "condition": "(packageManager == \"npm\")",
            "args": {
                "executable": "npm",
                "args": "install"
            },
            "continueOnError": true
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"yarn\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n  1. Start infrastructure:  docker compose up -d\n  2. Run the application:   dotnet run\n  3. Frontend dev server:   yarn dev"
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"yarn\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\n  Make sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n      cratis ai update\n  to get all the AI rules, skills, and coding agent integration in place.\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"pnpm\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n  1. Start infrastructure:  docker compose up -d\n  2. Run the application:   dotnet run\n  3. Frontend dev server:   pnpm dev"
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"pnpm\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\n  Make sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n      cratis ai update\n  to get all the AI rules, skills, and coding agent integration in place.\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"npm\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n  1. Start infrastructure:  docker compose up -d\n  2. Run the application:   dotnet run\n  3. Frontend dev server:   npm run dev"
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"npm\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\n  Make sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n      cratis ai update\n  to get all the AI rules, skills, and coding agent integration in place.\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show getting started instructions.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"none\")",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project is ready! Next steps:\n  1. Install frontend dependencies manually (e.g. npm install)\n  2. Start infrastructure:  docker compose up -d\n  3. Run the application:   dotnet run\n  4. Frontend dev server:   npm run dev"
                }
            ],
            "args": {
                "files": "1"
            }
        },
        {
            "description": "Show the Cratis AI update hint.",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "condition": "(packageManager == \"none\") && (SkipAiUpdateInstructions != true)",
            "continueOnError": true,
            "manualInstructions": [
                {
                    "text": "Your project ships with a .cratis/ai.json holding its Cratis AI configuration.\n  Make sure the Cratis CLI is installed - see https://cratis.io/cli - and run:\n      cratis ai update\n  to get all the AI rules, skills, and coding agent integration in place.\n\nSee README.md for full details."
                }
            ],
            "args": {
                "files": "1"
            }
        }
    ],
    "precedence": 1
}
